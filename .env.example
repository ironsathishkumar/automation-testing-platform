NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/automation_testing_platform
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_DAYS=60
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
ARTIFACT_ROOT=storage/artifacts
DOCUMENT_ROOT=storage/documents
LOG_ROOT=storage/logs
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api
# Optional. Mobile tests call this Appium server. Performance tests need the k6 binary on PATH.
# APPIUM_URL=http://127.0.0.1:4723
# Optional OpenAI-compatible provider. AI features return a configuration error until a key is set.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
